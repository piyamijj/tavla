<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Release-build-type manifest overlay, merged automatically by
         Gradle into the final manifest for release builds only.

         flutter create's default template (src/main/AndroidManifest.xml,
         regenerated fresh by CI on every run) does not declare the
         INTERNET permission for release builds - confirmed via Flutter's
         own official docs. Every release APK built by this project's CI
         had zero network permission until this file was added, which is
         the real cause of every "SocketException: Failed host lookup"
         style failure reported so far - it has nothing to do with DNS,
         TLS, or server configuration. Placed here rather than in
         src/main/ specifically so `flutter create` never overwrites it. -->
    <uses-permission android:name="android.permission.INTERNET"/>
</manifest>
